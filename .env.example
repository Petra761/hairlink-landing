# Plantilla de variables de entorno. Copiar este archivo como ".env" y completar los valores.
# Solo se usan claves PÚBLICAS: todo lo que empieza con VITE_ queda visible en el navegador.
# Nunca poner aquí la clave "service_role" ni ninguna clave privada de Supabase.

# URL del proyecto de Supabase (se obtiene en la sección 3)
VITE_SUPABASE_URL=

# Clave pública (publishable / anon) del proyecto de Supabase
VITE_SUPABASE_PUBLISHABLE_KEY=